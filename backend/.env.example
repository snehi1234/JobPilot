# Copy this file to ".env" for local dev (vercel dev reads it), and set the
# same variable in the Vercel dashboard (Project → Settings → Environment
# Variables) for production.

# REQUIRED: Groq API key from an organization on the Free plan.
# Get one at https://console.groq.com/keys. Do not upgrade the organization or
# add a paid provider for this release. Quota exhaustion returns an error.
GROQ_API_KEY=

# OPTIONAL: your Google OAuth Web-application client ID. When set, the backend
# REQUIRES a valid signed-in user (verifies the Google ID token) on every
# request and rate-limits per user. Leave empty to disable auth enforcement.
GOOGLE_CLIENT_ID=

# Supabase (cloud storage for per-user profiles). Create a project at
# https://supabase.com, then find these under Project Settings → API.
# Use the SERVICE ROLE key (secret), NOT the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL: max AI requests (generate + parse combined) allowed per signed-in
# user per calendar month. Protects the shared free AI quota from any single
# heavy user starving everyone else. Requires Supabase to be configured
# (falls open / unlimited if DB isn't set up). Defaults to 300 if unset.
USAGE_MONTHLY_LIMIT=300
